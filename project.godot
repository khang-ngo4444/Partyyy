; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PartyBash"
config/version="0.1.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

NetManager="*res://autoload/net_manager.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
PerformanceManager="*res://autoload/performance_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[dotnet]

project/assembly_name="PartyBash"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/physics_placer/plugin.cfg")

[file_customization]

folder_colors={
"res://lobby/": "red"
}

[filesystem]

import/blender/enabled=false

[fusion]

connection/app_id="6fdcc40b-c835-4aa8-ab45-cecd78087fcc"
connection/default_region="asia"

