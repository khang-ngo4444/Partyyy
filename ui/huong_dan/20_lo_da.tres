[gd_resource type="Resource" script_class="TrangHuongDan" format=3]

[ext_resource type="Script" path="res://ui/trang_huong_dan.gd" id="1_th"]

[resource]
script = ExtResource("1_th")
tieu_de = "20 · Lở đá"
noi_dung = "[b]WASD[/b] di chuyển. Ván này không nhảy.
[b]Chuột trái / F[/b] đánh choáng · [b]Chuột phải / G[/b] chưởng hất đối thủ.

Leo lên đỉnh càng sớm càng tốt. Tránh vòng đỏ báo đá rơi và đá đang lăn xuống dốc. Né sang bên để tránh đá.

Thiên thạch tiến từ chân dốc: đừng đứng lại quá lâu. Chạm đá hoặc bị thiên thạch đuổi kịp sẽ bị loại. Người về đích được bảo vệ, chuyển sang xem những người đang leo. Người về đích trước đứng trên; chưa về đích thì tính quãng đường leo, người bị loại sau đứng trên người bị loại trước."
