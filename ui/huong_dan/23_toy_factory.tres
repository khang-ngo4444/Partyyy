[resource]
script = ExtResource("1")
tieu_de = "23 · Xưởng súng nước"
noi_dung = "WASD chạy · E nhặt / đặt xuống / lắp tại bàn có tên mình.
Thu đủ thân, bình, bơm, ống và vòi. Chỉ mang một mảnh; mảnh trùng loại không được lắp.

Ghép đủ 5 mảnh để có súng nước. Chuột trái ngắm và bắn, một lần mỗi giây. Trúng nước làm rơi mảnh đang cầm; mảnh đã lắp được giữ lại.

Ván dài 60 giây. Hoàn thành sớm nhất đứng đầu, tiếp theo tính số mảnh đã lắp."
