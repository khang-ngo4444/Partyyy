[node name="Guide" type="RichTextLabel" parent="HowToOverlay/Center/Panel/VBox"]
custom_minimum_size = Vector2(496, 260)
layout_mode = 2
theme_override_colors/default_color = Color(0.83, 0.90, 0.89, 0.90)
theme_override_font_sizes/normal_font_size = 14
theme_override_font_sizes/bold_font_size = 14
bbcode_enabled = true
text = "[color=#8fe7d4]01  PHÒNG CHỜ[/color]\nChọn nhân vật, khám phá phòng và đứng lên ô giữa sàn khi sẵn sàng.\n\n[color=#8fe7d4]02  BÀN PARTY[/color]\nTới lượt mình: tung xúc xắc, chọn đường và dùng vật phẩm bằng phím số. Thu thập chìa khóa để mở rương và nhận cốc.\n\n[color=#8fe7d4]03  MINIGAME[/color]\nCuối mỗi vòng, cả phòng vào minigame. Xếp hạng quyết định thứ tự lượt vòng sau.\n\n[color=#8fe7d4]MỤC TIÊU[/color]\nNgười đầu tiên đạt đủ số cốc sẽ thắng ván."
fit_content = true
scroll_active = false

